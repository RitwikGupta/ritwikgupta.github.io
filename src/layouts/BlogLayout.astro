---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";
import { formatUtcDate } from "../utils/date";

interface Props {
    frontmatter: CollectionEntry<"blog">["data"];
}

const { frontmatter } = Astro.props;
const published = formatUtcDate(frontmatter.pubDate);
---

<Layout
    title={frontmatter.title}
    desc={frontmatter.description}
    ogImage={frontmatter.og_image}
>
    <main class="site-shell">
        <article class="mx-auto max-w-[70ch]">
            <a href="/blog" class="back-link">&larr; See all posts</a>
            <header class="mt-10 mb-12">
                <h1 class="page-title">{frontmatter.title}</h1>
                <time class="meta-label mt-4 block" datetime={frontmatter.pubDate.toISOString()}>
                    Published {published}
                </time>
                {frontmatter.og_image && (
                    <img
                        class="mt-8 aspect-[16/9] w-full rounded-[var(--radius)] border border-[var(--border)] object-cover"
                        src={frontmatter.og_image}
                        alt=""
                    />
                )}
            </header>
            <div class="prose editorial-prose">
                <slot />
            </div>
        </article>
    </main>
</Layout>
