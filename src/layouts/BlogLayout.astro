---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";
import { formatUtcDate } from "../utils/date";
import ProgressiveImage from "../components/ProgressiveImage.astro";
import { contentImageFromMetadata } from "../utils/content-images";
import DraftNotice from "../components/DraftNotice.astro";

interface Props {
    frontmatter: CollectionEntry<"blog">["data"];
}

const { frontmatter } = Astro.props;
const published = formatUtcDate(frontmatter.pubDate);
const heroImage = contentImageFromMetadata(frontmatter.og_image);
---

<Layout
    title={frontmatter.title}
    desc={frontmatter.description}
    ogImage={frontmatter.og_image.src}
    noindex={frontmatter.draft}
    ogType="article"
    publishedTime={frontmatter.pubDate}
>
    <DraftNotice slot="banner" draft={frontmatter.draft} />
    <main class="site-shell">
        <article class="mx-auto max-w-[70ch]">
            <a href="/blog" class="back-link">&larr; See all posts</a>
            <header class="mt-10 mb-12">
                <h1 class="page-title">{frontmatter.title}</h1>
                <time class="meta-label mt-4 block" datetime={frontmatter.pubDate.toISOString()}>
                    Published {published}
                </time>
                {frontmatter.og_image && (
                    <ProgressiveImage
                        class="mt-8 aspect-[16/9] w-full rounded-[var(--radius)] border border-[var(--border)]"
                        source={heroImage}
                        alt=""
                        widths={[640, 960, 1280]}
                        sizes="min(100vw, 70ch)"
                        aspectRatio="16 / 9"
                        loading="eager"
                        fetchpriority="high"
                    />
                )}
            </header>
            <div class="prose editorial-prose">
                <slot />
            </div>
        </article>
    </main>
</Layout>
