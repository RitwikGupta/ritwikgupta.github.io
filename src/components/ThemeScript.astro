<!-- Theme toggle functionality -->
<script is:inline>
    const applyTheme = (isDark) => {
        const root = document.documentElement;
        const theme = isDark ? 'dark' : 'light';
        const background = isDark ? '#0B1120' : '#ffffff';

        root.dataset.theme = theme;
        try {
            localStorage.setItem('theme', theme);
        } catch (e) {
            // Ignore storage write failures (private mode / blocked storage).
        }
        // Keep color-scheme and background consistent immediately
        root.style.colorScheme = theme;
        root.style.backgroundColor = background;
        document.body && (document.body.style.backgroundColor = background);
    };

    window.__toggleTheme = () => {
        const isDark = document.documentElement.dataset.theme !== 'dark';
        applyTheme(isDark);
    };

    document.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const toggle = target.closest('[data-theme-toggle="true"]');
        if (!toggle) return;

        window.__toggleTheme();
    }, { capture: true });
</script>
