---
import rawStoryData from "../data/opt-story.json";
import "../styles/opt-story.css";
import "../styles/opt-story-mobile.css";
import OptStoryMethods from "./OptStoryMethods.astro";
import OptStoryMobileScene from "./OptStoryMobileScene.astro";
import OptStoryStage from "./OptStoryStage.astro";
import type {
    CompactFlow,
    CompactMark,
    CompactProgramPoint,
    OptStoryClientData,
    OptStoryData,
} from "../types/opt-story";
import { buildOptStoryMobileView } from "../utils/opt-story-mobile-view";

const storyData = rawStoryData as unknown as OptStoryData;
if (storyData.schemaVersion !== 7) {
    throw new Error(`Unexpected OPT story schema ${storyData.schemaVersion}`);
}
const mobileView = buildOptStoryMobileView(storyData);
const fieldCssVariables = storyData.cohort.fieldGroups
    .map((field) => `--field-${field.key}:${field.color}`)
    .join(";");

const number = (value: number) => new Intl.NumberFormat("en-US").format(value);
const money = (value: number) => new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
}).format(value);
const billions = (value: number) => `$${(value / 1_000_000_000).toFixed(3).replace(/\.?0+$/, "")} billion`;

const degree = new Map(storyData.cohort.degreeGroups.map((row) => [row.key, row]));
const defaultFeeScenario = storyData.compensation.feeScenarios.find(
    (row) => row.feeUsd === storyData.meta.defaultFeeUsd,
)!;
const fieldOutcome = new Map(defaultFeeScenario.outcomes.fields.map((row) => [row.key, row]));
const settingOutcome = new Map(defaultFeeScenario.outcomes.workSettings.map((row) => [row.key, row]));
const pricedOutPct = (row: { matchedPeople: number; doesNotContinuePeople: number }) => (
    row.matchedPeople ? 100 * row.doesNotContinuePeople / row.matchedPeople : 0
);
const biologyPricedOut = pricedOutPct(fieldOutcome.get("biological-science")!);
const universityPricedOut = pricedOutPct(settingOutcome.get("university-research")!);
const industryPricedOut = pricedOutPct(settingOutcome.get("other-named-employer")!);
const leadingFieldKeys = new Set(["computer-science", "business", "engineering"]);
const leadingFieldPct = 100 * storyData.cohort.fieldGroups
    .filter((row) => leadingFieldKeys.has(row.key))
    .reduce((sum, row) => sum + row.people, 0) / storyData.meta.totalEntrants;
const industrySetting = storyData.cohort.workSettings.find((row) => row.key === "other-named-employer")!;
const universitySetting = storyData.cohort.workSettings.find((row) => row.key === "university-research")!;
const linContinuesByDefault = storyData.compensation.comparisons.lin.totalCompensationUsd >= storyData.meta.defaultFeeUsd;

const flowMap = new Map<string, CompactFlow>();
for (const row of storyData.cohort.flows) {
    const key = `${row.degree}|${row.workSetting}`;
    const existing = flowMap.get(key);
    if (existing) existing[2] += row.people;
    else flowMap.set(key, [row.degree, row.workSetting, row.people]);
}

const clientData: OptStoryClientData = {
    schemaVersion: 7,
    meta: {
        fiscalYear: storyData.meta.fiscalYear,
        defaultFeeUsd: storyData.meta.defaultFeeUsd,
        feeMinUsd: storyData.meta.feeMinUsd,
        feeMaxUsd: storyData.meta.feeMaxUsd,
        feeStepUsd: storyData.meta.feeStepUsd,
        totalEntrants: storyData.meta.totalEntrants,
        defaultGrossExposureUsd: storyData.meta.defaultGrossExposureUsd,
        optMarkCount: storyData.meta.optMarkCount,
        approximatePeoplePerOptMark: storyData.meta.approximatePeoplePerOptMark,
        knownCompensationPeople: storyData.meta.knownCompensationPeople,
        unknownCompensationPeople: storyData.meta.unknownCompensationPeople,
    },
    openingPopulation: storyData.openingPopulation,
    degreeGroups: storyData.cohort.degreeGroups,
    fieldGroups: storyData.cohort.fieldGroups,
    workSettings: storyData.cohort.workSettings,
    marks: storyData.cohort.marks.map((row): CompactMark => [
        row.id,
        row.degree,
        row.field,
        row.workSetting,
        row.isExplicitPostdoc ? 1 : 0,
        row.occupationFamily,
        row.benchmarkCompensationUsd,
    ]),
    flows: Array.from(flowMap.values()),
    feeScenarios: storyData.compensation.feeScenarios,
    comparisons: storyData.compensation.comparisons,
    programs: storyData.schoolPrograms.scatter.map((row): CompactProgramPoint => [
        row.school,
        row.degree,
        row.cip,
        row.major,
        row.expectedCompleters,
        row.optWithin60,
        row.share60Pct,
    ]),
};
const storyJson = JSON.stringify(clientData).replace(/</g, "\\u003c");
---

<section class="opt-story" aria-label="OPT fee visual story" data-opt-story style={fieldCssVariables}>
    <script is:inline type="application/json" id="opt-story-data" set:html={storyJson}></script>

    <noscript>
        <div class="noscript-summary">
            <h2>The story in brief</h2>
            <p>
                Optional Practical Training gives eligible F-1 students temporary permission to work in jobs related to their degree. Initial post-completion OPT may last up to 12 months, and some STEM graduates may later apply for a 24-month extension.
            </p>
            <p>
                The FY{storyData.meta.fiscalYear} SEVIS records contain {number(storyData.meta.totalEntrants)} initial post-completion OPT entrants. At the default {money(storyData.meta.defaultFeeUsd)} fee, {number(defaultFeeScenario.continuesPeople)} would continue under the scenario and {number(defaultFeeScenario.doesNotContinuePeople)} would not continue. The comparison covers the {number(storyData.meta.knownCompensationPeople)} entrants whose jobs receive either an occupation or broader occupation-family compensation estimate. This is a counterfactual rule, not a forecast.
            </p>
        </div>
    </noscript>

    <div class="story-grid">
        <div class="story-copy">
            <section class="story-step is-active" data-scene="graduates">
                <div class="step-card">
                    <p class="step-number">01 / International graduates</p>
                    <h2>America's universities are top notch, and people come from all around the world to study.</h2>
                    <p>U.S. universities awarded <strong>{number(storyData.openingPopulation.people)}</strong> bachelor's, master's, and doctoral degrees to international students in 2021–22. These graduates spent years studying in American classrooms and laboratories. Each circle represents about {Math.round(storyData.openingPopulation.people / storyData.openingPopulation.markCount)} degrees.</p>
                </div>
                <OptStoryMobileScene scene="graduates" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="orientation">
                <div class="step-card">
                    <p class="step-number">02 / What is OPT?</p>
                    <h2>Knowledge is useless without practice, so Optional Practical Training (OPT) lets many international graduates work in the field they studied.</h2>
                    <p>An F-1 student can apply for up to 12 months of post-completion OPT. Some STEM graduates can later apply for a 24-month extension.</p>
                </div>
                <OptStoryMobileScene scene="orientation" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="opt">
                <div class="step-card">
                    <p class="step-number">03 / Initial OPT</p>
                    <h2>OPT brings part of that graduating class into the American workforce.</h2>
                    <p>SEVIS records show <strong>{number(storyData.meta.totalEntrants)} people</strong> starting initial post-completion OPT in FY{storyData.meta.fiscalYear}. The blue block is the talent pool we follow from here.</p>
                    <p class="character-copy"><b>A</b> Asha completed an MS in computer science.</p>
                    <p class="character-copy"><b>L</b> Dr. Lin completed an engineering PhD and is entering a postdoc.</p>
                </div>
                <OptStoryMobileScene scene="opt" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="composition">
                <div class="step-card">
                    <p class="step-number">04 / Degrees and fields</p>
                    <h2>More than half enter with a master's degree.</h2>
                    <p>Master's graduates account for <strong>{number(degree.get("masters")!.people)}</strong> entrants, followed by <strong>{number(degree.get("bachelors")!.people)}</strong> bachelor's and <strong>{number(degree.get("doctorate")!.people)}</strong> doctorates. Computer science, business, and engineering together make up <strong>{leadingFieldPct.toFixed(1)}%</strong>.</p>
                </div>
                <OptStoryMobileScene scene="composition" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="connections">
                <div class="step-card">
                    <p class="step-number">05 / What OPT connects</p>
                    <h2>American employers put that training to work.</h2>
                    <p>Most entrants—<strong>{number(industrySetting.people)}</strong>—head to industry. Another <strong>{number(universitySetting.people)}</strong> go to universities or research institutions.</p>
                    <p>Asha heads toward software. Dr. Lin heads toward a university postdoc.</p>
                </div>
                <OptStoryMobileScene scene="connections" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="workers">
                <div class="step-card">
                    <p class="step-number">06 / American workers</p>
                    <h2>Does OPT displace American talent?</h2>
                    <p>The strongest objection to OPT is that when an international graduate gets a job, an American applicant may not. The story, however, is not so clear.</p>
                </div>
            </section>

            <section class="story-step" data-scene="evidence">
                <div class="step-card">
                    <p class="step-number">07 / What research finds</p>
                    <h2>Studies find effects in both directions.</h2>
                    <p>A <a href="https://www.census.gov/library/working-papers/2016/adrm/ces-wp-16-56.html">Census Bureau study</a> of immigration <i>broadly</i> found small declines in native workers' earnings and employment. A <a href="https://aisel.aisnet.org/misq/vol48/iss2/15/">2024 study of STEM OPT</a> found that its expansion increased domestic STEM employment, especially in information technology. A <a href="https://www.aeaweb.org/articles?id=10.1257%2Fpandp.20261100">2026 study</a> found that domestic STEM degree completion rose after OPT expanded.</p>
                    <p>Individual workers may face greater competition for a particular job while domestic STEM employment and training grow across the economy.</p>
                </div>
            </section>

            <section class="story-step" data-scene="value">
                <div class="step-card">
                    <p class="step-number">08 / Employment value</p>
                    <h2>Asha and Dr. Lin bring different skills to different labor markets.</h2>
                    <p>Asha's software role carries <strong>{money(storyData.compensation.comparisons.asha.wageUsd)} in median wages</strong> and <strong>{money(storyData.compensation.comparisons.asha.totalCompensationUsd)} in estimated compensation</strong>.</p>
                    <p>Dr. Lin's postdoc has a <strong>{money(storyData.compensation.comparisons.lin.salaryUsd)} median salary</strong>. Including estimated employer-paid benefits, that is about <strong>{money(storyData.compensation.comparisons.lin.totalCompensationUsd)} in annual compensation</strong>.</p>
                </div>
                <OptStoryMobileScene scene="value" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="gate">
                <div class="step-card step-card--turn">
                    <p class="step-number">09 / The gate</p>
                    <h2>A <span data-copy-fee>{money(storyData.meta.defaultFeeUsd)}</span> fee closes part of the bridge.</h2>
                    <p>Every entrant faces the same price, including Asha and Dr. Lin.</p>
                    <p>If all {number(storyData.meta.totalEntrants)} entrants crossed once, the fees would total <strong data-copy-gross-exposure>{billions(storyData.meta.defaultGrossExposureUsd)}</strong>.</p>
                </div>
                <OptStoryMobileScene scene="gate" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="student">
                <div class="step-card">
                    <p class="step-number">10 / If the student pays</p>
                    <h2>The fee arrives after years of educational expenses.</h2>
                    <p>Among master's entrants, median reported annual tuition was <strong>{money(storyData.studentPaid.tuitionUsd)}</strong>. Their Form I-20 records listed <strong>{money(storyData.studentPaid.reportedFundingUsd)}</strong> in total financial resources for one academic year, including personal or family funds, school aid, outside support, and expected on-campus earnings.</p>
                </div>
                <OptStoryMobileScene scene="student" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="threshold">
                <div class="step-card step-card--turn">
                    <p class="step-number">11 / Employer decision</p>
                    <h2>Set the price of entry.</h2>
                    <p>Choose an OPT fee. The model assumes that an employer would pay it when the job's typical annual compensation is at least as high. For some records, the data support only a broader occupation-family estimate; where they support neither, we do not guess.</p>
                </div>
                <OptStoryMobileScene scene="threshold" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="impacts">
                <div class="step-card">
                    <p class="step-number">12 / Fields and occupations</p>
                    <h2>The fee reshapes the talent pool.</h2>
                    <p>Biology and biomedical science show how quickly specialized talent can be lost. A university laboratory may hire a postdoc at a typical salary of <strong>{money(storyData.compensation.comparisons.lin.salaryUsd)}</strong> because that researcher has expertise needed for a particular project. Salary and estimated benefits bring the position's annual compensation to about <strong>{money(storyData.compensation.comparisons.lin.totalCompensationUsd)}</strong>.</p>
                    <p>At <strong data-copy-fee>{money(storyData.meta.defaultFeeUsd)}</strong>, <span data-copy-lin-outcome>{linContinuesByDefault ? "Dr. Lin's postdoc would remain in the modeled talent pool" : "Dr. Lin's postdoc would not continue under the model"}</span>. Among biology graduates with compensation estimates, <strong data-copy-biology-outcome>{biologyPricedOut.toFixed(1)}% would not continue</strong>.</p>
                </div>
                <OptStoryMobileScene scene="impacts" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="settings">
                <div class="step-card">
                    <p class="step-number">13 / Employers</p>
                    <h2>Universities feel the fee differently from industry.</h2>
                    <p>The same fee sits beside an industry salary, a university postdoc, or a public-sector role. <span data-copy-setting-outcome>At {money(storyData.meta.defaultFeeUsd)}, {universityPricedOut.toFixed(1)}% of university and research jobs with compensation estimates would not continue, compared with {industryPricedOut.toFixed(1)}% of industry jobs with estimates.</span></p>
                </div>
                <OptStoryMobileScene scene="settings" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="organizations">
                <div class="step-card">
                    <p class="step-number">14 / Organizations</p>
                    <h2>The exposure is concentrated in particular schools and employers.</h2>
                    <p>These rankings count initial OPT entrants at schools and clearly identified employers. The next view examines how frequently individual school programs lead to OPT.</p>
                </div>
                <OptStoryMobileScene scene="organizations" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="programs">
                <div class="step-card">
                    <p class="step-number">15 / School programs</p>
                    <h2>Some programs send nearly every expected completer into OPT.</h2>
                    <p>The chart compares program size with the share of expected completers who begin OPT within 60 days. It includes each school, degree, and program with at least 50 expected completions.</p>
                </div>
                <OptStoryMobileScene scene="programs" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="alternatives">
                <div class="step-card">
                    <p class="step-number">16 / Other paths</p>
                    <h2>Graduates may seek another route.</h2>
                    <p>J-1 sponsorship, an H-1B petition, further study, departure, and overseas work are all possible. The records cannot show which route a person would take.</p>
                </div>
                <OptStoryMobileScene scene="alternatives" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="ending">
                <div class="step-card">
                    <p class="step-number">17 / The selected fee</p>
                    <h2>The fee changes the talent pool America retains.</h2>
                    <p>At <strong data-copy-fee>{money(storyData.meta.defaultFeeUsd)}</strong>, <span data-copy-ending-outcome>{number(defaultFeeScenario.continuesPeople)} would continue and {number(defaultFeeScenario.doesNotContinuePeople)} would not continue</span> among jobs with compensation estimates. <span data-copy-ending-biology>Among biology graduates in that group, {biologyPricedOut.toFixed(1)}% would not continue.</span></p>
                </div>
                <OptStoryMobileScene scene="ending" storyData={storyData} mobileView={mobileView} />
            </section>

            <section class="story-step" data-scene="conclusion">
                <div class="step-card">
                    <p class="step-number">18 / The talent America keeps</p>
                    <h2>America has already invested in this talent.</h2>
                    <p>American universities have already welcomed and trained people who can staff laboratories, build companies, develop new technologies, and train the next generation.</p>
                    <p>American workers deserve protection from underpayment and direct replacement. A large OPT fee would make financial backing the deciding factor, regardless of merit or the importance of the work.</p>
                    <p>Developing American talent and retaining graduates trained here strengthen the same workforce.</p>
                </div>
            </section>
        </div>

        <OptStoryStage storyData={storyData} />
    </div>

    <OptStoryMethods storyData={storyData} />
</section>

<script>
    import "../scripts/opt-story";
</script>
