---
import type { FieldGroupRow } from "../types/opt-story";
import OptStoryMobileFieldLegendList from "./OptStoryMobileFieldLegendList.astro";

interface Props {
    fields: FieldGroupRow[];
    collapsible?: boolean;
    afterChart?: boolean;
}

const { fields, collapsible = false, afterChart = false } = Astro.props;
---

{collapsible ? (
    <details class="mobile-collapsible-key">
        <summary>Field colors</summary>
        <OptStoryMobileFieldLegendList fields={fields} />
    </details>
) : (
    <OptStoryMobileFieldLegendList fields={fields} afterChart={afterChart} />
)}
