<button
    class="theme-toggle"
    aria-label="Toggle color theme"
    data-theme-toggle
    type="button"
>
    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20.4 15.4A9 9 0 0 1 8.6 3.6 9 9 0 1 0 20.4 15.4Z" />
    </svg>
    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5" stroke-width="1.8" />
        <path stroke-linecap="round" stroke-width="1.8" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
    </svg>
</button>

<style>
    .theme-toggle {
        display: inline-grid;
        width: 2.4rem;
        height: 2.4rem;
        flex: none;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-muted);
        color: var(--text);
        cursor: pointer;
        transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
    }
    .theme-toggle:hover { border-color: var(--border-strong); color: var(--link); transform: translateY(-1px); }
    svg { width: 1rem; height: 1rem; }
    .sun { display: none; }
    :global(html[data-theme="dark"]) .sun { display: block; }
    :global(html[data-theme="dark"]) .moon { display: none; }
</style>
