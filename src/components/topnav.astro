---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
    { href: "/publications", text: "Publications" },
    { href: "/blog", text: "Blog" },
    { href: "/students", text: "Students" },
    { href: "/press", text: "Press" },
    { href: "/RitwikCV.pdf", text: "CV", target: "_blank" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/RitwikCV.pdf" && (path === href || path.startsWith(`${href}/`));
---

<nav class="site-nav" aria-label="Primary navigation">
    <div class="nav-inner">
        <a href="/" class:list={["brand", { active: path === "/" }]} aria-current={path === "/" ? "page" : undefined}>
            Ritwik Gupta
        </a>

        <div class="desktop-nav">
            <div class="nav-links">
                {links.map((link) => (
                    <a
                        href={link.href}
                        target={link.target}
                        rel={link.target ? "noopener noreferrer" : undefined}
                        class:list={["nav-link", { active: isActive(link.href) }]}
                        aria-current={isActive(link.href) ? "page" : undefined}
                    >
                        {link.text}
                    </a>
                ))}
            </div>
            <ThemeToggle />
        </div>

        <div class="mobile-controls">
            <ThemeToggle />
            <button id="mobile-menu-button" class="menu-button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="mobile-menu" hidden>
        {links.map((link) => (
            <a
                href={link.href}
                target={link.target}
                rel={link.target ? "noopener noreferrer" : undefined}
                class:list={["mobile-link", { active: isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
            >{link.text}</a>
        ))}
    </div>
</nav>

<script is:inline>
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    const closeMenu = (restoreFocus = false) => {
        if (!(menu instanceof HTMLElement) || !(button instanceof HTMLElement)) return;
        menu.hidden = true;
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Open navigation menu");
        if (restoreFocus) button.focus();
    };
    button?.addEventListener("click", () => {
        if (!(menu instanceof HTMLElement)) return;
        const opening = menu.hidden;
        menu.hidden = !opening;
        button.setAttribute("aria-expanded", String(opening));
        button.setAttribute("aria-label", opening ? "Close navigation menu" : "Open navigation menu");
        if (opening) menu.querySelector("a")?.focus();
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu instanceof HTMLElement && !menu.hidden) closeMenu(true);
    });
    window.matchMedia("(min-width: 640px)").addEventListener?.("change", (event) => {
        if (event.matches) closeMenu();
    });
</script>

<style>
    .site-nav { width: 100%; border-bottom: 1px solid var(--border); font-family: var(--font-sans); }
    .nav-inner { display: flex; width: min(100%, var(--shell)); min-height: 4.5rem; margin: auto; padding: 0 1.25rem; align-items: center; justify-content: space-between; gap: 2rem; }
    .brand { position: relative; color: var(--text); font-size: 0.92rem; font-weight: 750; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; }
    .desktop-nav, .nav-links, .mobile-controls { display: flex; align-items: center; }
    .desktop-nav { gap: 1.25rem; }
    .nav-links { gap: clamp(0.8rem, 2.1vw, 1.6rem); }
    .nav-link { position: relative; padding: 1.65rem 0; color: var(--text-muted); font-size: 0.76rem; font-weight: 650; letter-spacing: 0.035em; text-decoration: none; }
    .nav-link:hover, .nav-link.active, .brand:hover, .brand.active { color: var(--text); }
    .nav-link.active::after, .brand.active::after { position: absolute; right: 0; bottom: -0.18rem; left: 0; height: 2px; border-radius: 2px; background: var(--goldenrod); content: ""; }
    .mobile-controls { display: none; gap: 0.65rem; }
    .menu-button { display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text); cursor: pointer; }
    .menu-button svg { width: 1.1rem; height: 1.1rem; }
    .mobile-menu { border-top: 1px solid var(--border); padding: 0.65rem 1.25rem 1rem; background: var(--surface); }
    .mobile-menu[hidden] { display: none; }
    .mobile-link { display: block; padding: 0.75rem 0.25rem; border-bottom: 1px solid var(--border); color: var(--text-muted); font-size: 0.82rem; font-weight: 650; text-decoration: none; }
    .mobile-link:last-child { border-bottom: 0; }
    .mobile-link.active { color: var(--link); }
    @media (max-width: 639px) { .desktop-nav { display: none; } .mobile-controls { display: flex; } }
    @media (min-width: 640px) { .nav-inner { padding-inline: clamp(1.5rem, 4vw, 3rem); } }
</style>
