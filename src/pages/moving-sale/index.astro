---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";

const items = await getCollection("movingSale");
const sections = [
    {
        id: "available",
        title: "Available",
        items: items.filter((item) => !item.data.claimed),
        sold: false,
    },
    {
        id: "sold",
        title: "Sold",
        items: items.filter((item) => item.data.claimed),
        sold: true,
    },
].filter((section) => section.items.length > 0);

const priceFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 2,
});

const interestLink = (name: string) => {
    const subject = encodeURIComponent(`Moving sale: ${name}`);
    const body = encodeURIComponent(
        `Hi Ritwik,\n\nI'm interested in the ${name}. Is it still available?\n\nThanks!`,
    );

    return `mailto:ritwikgupta@berkeley.edu?subject=${subject}&body=${body}`;
};
---

<Layout
    title="Moving Sale | Ritwik Gupta"
    desc="Furniture and household items available from Ritwik Gupta's moving sale."
>
    <main class="site-shell">
        <PageHeader title="Moving Sale">
            <p class="intro">
                Interested in something? Send me an email from the item card.
                Product links show the same or equivalent item for reference.
            </p>
        </PageHeader>

        {sections.map((section) => (
            <section
                aria-labelledby={`${section.id}-heading`}
                class:list={["item-section", { "sold-section": section.sold }]}
            >
                <div class="section-heading">
                    <h2 id={`${section.id}-heading`}>{section.title}</h2>
                    <span>{section.items.length} {section.items.length === 1 ? "item" : "items"}</span>
                </div>

                <div class="item-grid">
                    {section.items.map(({ data: item }) => (
                        <article
                            class:list={["item-card", "surface-card", { "sold-card": section.sold }]}
                            aria-label={section.sold ? `${item.name} — sold` : item.name}
                        >
                            <div class="image-frame">
                                <img
                                    src={item.image_url}
                                    alt={section.sold ? "" : item.name}
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                />
                                {section.sold && <span class="sold-badge">Sold</span>}
                            </div>
                            <div class="card-content">
                                <div class="title-row">
                                    <h3>{item.name}</h3>
                                    <p class="price">{priceFormatter.format(item.price)}</p>
                                </div>
                                {item.notes && <p class="notes">{item.notes}</p>}
                                {(!section.sold || item.product_url) && (
                                    <div class="card-actions">
                                        {!section.sold && (
                                            <a class="interest-link" href={interestLink(item.name)}>
                                                I'm interested
                                            </a>
                                        )}
                                        {item.product_url && (
                                            <a
                                                class="product-link"
                                                href={item.product_url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                View product <span aria-hidden="true">&nearr;</span>
                                            </a>
                                        )}
                                    </div>
                                )}
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        ))}
    </main>
</Layout>

<style>
    .intro {
        max-width: 42rem;
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.7;
    }

    .item-section + .item-section {
        margin-top: 4rem;
    }

    .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
    }

    .section-heading h2 {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .section-heading span {
        color: var(--text-muted);
        font-size: 0.875rem;
        font-weight: 600;
    }

    .item-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
        gap: 1.5rem;
    }

    .item-card {
        display: flex;
        min-width: 0;
        overflow: hidden;
        flex-direction: column;
    }

    .image-frame {
        position: relative;
        display: grid;
        height: 15rem;
        place-items: center;
        overflow: hidden;
        background: var(--surface-muted);
    }

    .image-frame img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 250ms ease;
    }

    .item-card:hover .image-frame img {
        transform: scale(1.025);
    }

    .card-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 1.25rem;
    }

    .title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .title-row h3 {
        font-size: 1.0625rem;
        font-weight: 700;
        line-height: 1.4;
    }

    .price {
        flex: none;
        color: var(--text);
        font-size: 1rem;
        font-weight: 750;
    }

    .notes {
        margin-top: 0.75rem;
        color: var(--text-muted);
        font-size: 0.875rem;
        line-height: 1.6;
    }

    .card-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1.25rem;
    }

    .interest-link {
        border-radius: 0.5rem;
        background: var(--text);
        color: var(--canvas);
        font-size: 0.8125rem;
        font-weight: 700;
        padding: 0.625rem 0.875rem;
        transition: background-color 150ms ease, transform 150ms ease;
    }

    .interest-link:hover {
        background: var(--link);
        color: var(--surface);
        transform: translateY(-1px);
    }

    .product-link {
        color: var(--link);
        font-size: 0.8125rem;
        font-weight: 650;
        text-align: right;
    }

    .product-link:hover {
        color: var(--link-hover);
        text-decoration: underline;
    }

    .sold-section {
        padding-top: 0.5rem;
    }

    .sold-card {
        opacity: 0.58;
    }

    .sold-card .image-frame img {
        filter: grayscale(1);
    }

    .sold-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--midnight) 90%, transparent);
        color: var(--paper);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        padding: 0.4rem 0.7rem;
        text-transform: uppercase;
    }

    :global([data-theme="dark"]) .interest-link {
        background: var(--goldenrod);
        color: var(--midnight);
    }

    :global([data-theme="dark"]) .interest-link:hover {
        background: var(--link-hover);
        color: var(--midnight);
    }

    @media (max-width: 640px) {
        .image-frame {
            height: 13rem;
        }
    }
</style>
