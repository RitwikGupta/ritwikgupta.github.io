---
import Layout from "../layouts/Layout.astro";
import Intro from "./_home/intro.astro";
import Bio from "./_home/short-bio.md";
import PublicationItems from "./publications/_content/_item.astro";
---

<Layout
    title="Ritwik Gupta"
    desc="AI and Policy researcher driving innovation in humanitarian assistance and disaster response (HADR)"
>
    <main class="site-shell flex flex-col items-center gap-y-14">
        <Intro />
        <div
            class="prose editorial-prose prose-lg prose-p:m-0"
        >
            <Bio />
            <div class="not-prose flex items-center justify-end">
                <a
                    href="/about"
                    class="back-link"
                    >Read full bio &rarr;</a
                >
            </div>
        </div>
        <section class="w-full" aria-labelledby="selected-publications-heading">
            <div class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-[var(--border)] pb-4">
                <h2
                    id="selected-publications-heading"
                    class="text-2xl font-bold sm:text-3xl"
                >
                    Recent Publications
                </h2>
                <a href="/publications" class="back-link">View all publications &rarr;</a>
            </div>
            <PublicationItems limit={3} />
        </section>
    </main>
</Layout>
