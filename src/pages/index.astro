---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Intro from "./_home/intro.astro";
import Bio from "./_home/short-bio.md";
import Highlights from "./_home/highlights.md";
---

<Layout
    title="Ritwik Gupta"
    desc="AI and Policy researcher driving innovation in humanitarian assistance and disaster response (HADR)"
>
    <main
        class="w-full md:w-3/4 xl:w-7/12 flex items-center justify-center flex-col gap-y-10 p-12"
    >
        <Intro />
        <div
            class="prose prose-lg prose-p:m-0 prose-a:text-blue-500 hover:prose-a:text-blue-600 transition-colors"
        >
            <Bio />
            <div class="not-prose flex items-center justify-end">
                <a
                    href="/about"
                    class="text-sm text-right text-gray-400 hover:text-gray-500 transition-colors font-semibold"
                    >Read full bio &rarr;</a
                >
            </div>
        </div>
        <div
            class="prose prose-a:text-blue-500 hover:prose-a:text-blue-600 transition-colors"
        >
            <Highlights />
        </div>
    </main>
</Layout>
