---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Ritwik Gupta | Blog"
    desc="AI and Policy researcher driving innovation in humanitarian assistance and disaster response (HADR)"
>
    <main class="site-shell">
        <header class="page-header">
            <a href="/" class="back-link">&larr; Back to home</a>
            <h1 class="page-title">Blog</h1>
        </header>
        <div class="grid w-full gap-7 md:grid-cols-2">
            {
                posts.map((p) => (
                    <a
                        href={`/blog/posts/${p.id}`}
                        class="surface-card group flex min-w-0 flex-col overflow-hidden text-[var(--text)] no-underline transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)]"
                    >
                        <img
                            src={p.data.og_image}
                            alt=""
                            loading="lazy"
                            class="aspect-[16/9] w-full border-b border-[var(--border)] object-cover"
                        />
                        <div class="flex flex-1 flex-col gap-3 p-6">
                        <time class="meta-label" datetime={p.data.pubDate.toISOString()}>
                            {
                                p.data.pubDate
                                    .toLocaleString("en-US", {
                                        timeZone: "UTC",
                                    })
                                    .split(",")[0]
                            }
                        </time>
                        <h2 class="text-xl font-bold leading-snug group-hover:text-[var(--link)] sm:text-2xl">{p.data.title}</h2>
                        <p class="text-base leading-relaxed text-[var(--text-muted)]">{p.data.description}</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Layout>
