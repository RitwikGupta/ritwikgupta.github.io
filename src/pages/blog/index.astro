---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import { formatUtcDate } from "../../utils/date";
import ProgressiveImage from "../../components/ProgressiveImage.astro";
import { contentImageFromMetadata } from "../../utils/content-images";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
---

<Layout
    title="Ritwik Gupta | Blog"
>
    <main class="site-shell">
        <PageHeader title="Blog" />
        <div class="grid w-full gap-7 md:grid-cols-2">
            {
                posts.map((p) => (
                    <a
                        href={`/blog/posts/${p.id}`}
                        class="surface-card group flex min-w-0 flex-col overflow-hidden text-[var(--text)] no-underline transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)]"
                    >
                        <ProgressiveImage
                            source={contentImageFromMetadata(p.data.og_image)}
                            alt=""
                            widths={[420, 840]}
                            sizes="(min-width: 768px) 50vw, 100vw"
                            aspectRatio="16 / 9"
                            loading="lazy"
                            class="aspect-[16/9] w-full border-b border-[var(--border)]"
                        />
                        <div class="flex flex-1 flex-col gap-3 p-6">
                        <time class="meta-label" datetime={p.data.pubDate.toISOString()}>
                            {formatUtcDate(p.data.pubDate)}
                        </time>
                        <h2 class="text-xl font-bold leading-snug group-hover:text-[var(--link)] sm:text-2xl">{p.data.title}</h2>
                        <p class="text-base leading-relaxed text-[var(--text-muted)]">{p.data.description}</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Layout>
