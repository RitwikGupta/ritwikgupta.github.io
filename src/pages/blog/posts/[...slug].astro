---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import OptStoryLayout from "../../../layouts/OptStoryLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const rendered = post.data.template === "standard" ? await render(post) : null;
const Content = rendered?.Content;
---

{
    post.data.template === "opt-story" ? (
        <OptStoryLayout frontmatter={post.data} />
    ) : Content ? (
        <BlogLayout frontmatter={post.data}>
            <Content />
        </BlogLayout>
    ) : null
}
