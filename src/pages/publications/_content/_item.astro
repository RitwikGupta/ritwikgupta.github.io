---
import { publications } from "./list";

publications.sort(
    (a, b) =>
        new Date(b.date).valueOf() -
        new Date(a.date).valueOf()
);
---

<div class="w-full flex items-center justify-center flex-col gap-y-12">
    {
        publications.map((p) => (
            <div class="w-full flex lg:items-start items-center justify-center lg:flex-row flex-col-reverse gap-x-10 gap-y-2">
                {p.imgSrc && (
                    <img
                        src={p.imgSrc}
                        alt={p.title}
                        class="lg:max-w-[250px] w-full"
                    />
                )}
                <div class="w-full flex items-start justify-center flex-col gap-y-2">
                    <a 
                        href={p.links[0]?.url || '#'} 
                        target="_blank" 
                        class="text-lg sm:text-2xl font-bold text-blue-600 dark:text-blue-400 hover:underline"
                    >
                        {p.title}
                    </a>
                    <p class="text-sm text-gray-600 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700 pb-2">
                        {p.authors
                            .map((author) =>
                                author.isPrimary
                                    ? author.name + "*"
                                    : author.name
                            )
                            .join(", ")}
                    </p>
                    <p class="text-gray-800 dark:text-gray-200 mt-2">{p.excerpt}</p>
                    <div class="w-full flex items-center justify-start flex-row flex-wrap gap-2">
                        {p.award && (
                            <span class="bg-yellow-400 dark:bg-yellow-500 text-black px-2 py-1 border border-transparent rounded-md text-sm font-semibold">
                                {p.award}
                            </span>
                        )}
                        {p.venue && (
                            <span class="bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100 px-2 py-1 border border-transparent rounded-md text-sm font-semibold">
                                {p.venue}
                            </span>
                        )}
                        {p.links.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                class="!text-black bg-gray-200 hover:bg-gray-300 px-2 py-1 border border-transparent rounded-md text-sm font-semibold"
                            >
                                {link.display}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        ))
    }
</div>
