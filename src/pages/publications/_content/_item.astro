---
import { publications } from "./list";
---

<div class="w-full flex items-center justify-center flex-col gap-y-12">
    {
        publications.map((p) => (
            <div class="w-full flex lg:items-start items-center justify-center lg:flex-row flex-col-reverse gap-x-10 gap-y-2">
                {p.imgSrc && (
                    <img
                        src={p.imgSrc}
                        alt={p.title}
                        class="lg:max-w-[250px] w-full"
                    />
                )}
                <div class="w-full flex items-start justify-center flex-col gap-y-2">
                    <h3 class="text-lg sm:text-2xl font-bold">{p.title}</h3>
                    <p class="text-gray-400">
                        {p.authors
                            .map((author) =>
                                author.isPrimary
                                    ? author.name + "*"
                                    : author.name
                            )
                            .join(", ")}
                    </p>
                    <p>{p.excerpt}</p>
                    <div class="w-full flex items-center justify-start flex-row flex-wrap gap-2">
                        {p.award && (
                            <span class="bg-yellow-400 px-2 py-1 border border-transparent rounded-md text-sm font-semibold">
                                {p.award}
                            </span>
                        )}
                        {p.venue && (
                            <span class="bg-blue-100 px-2 py-1 border border-transparent rounded-md text-sm font-semibold">
                                {p.venue}
                            </span>
                        )}
                        {p.links.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                class="bg-gray-200 hover:bg-gray-300 px-2 py-1 border border-transparent rounded-md text-sm font-semibold transition-colors"
                            >
                                {link.display}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        ))
    }
</div>
