---
import { publications } from "./list";

publications.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
---

<div class="grid w-full gap-8">
    {publications.map((p) => (
        <article class="surface-card grid overflow-hidden lg:grid-cols-[minmax(0,1fr)_15rem]">
            <div class="flex min-w-0 flex-col gap-3 p-6 sm:p-8">
                <a
                    href={p.links[0]?.url || "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xl font-bold leading-snug sm:text-2xl"
                >
                    {p.title}
                </a>
                <p class="sans border-b border-[var(--border)] pb-3 text-xs leading-relaxed text-[var(--text-muted)]">
                    {p.authors.map((author) => author.isPrimary ? `${author.name}*` : author.name).join(", ")}
                </p>
                <p class="text-base leading-relaxed text-[var(--text-muted)]">{p.excerpt}</p>
                <div class="sans mt-auto flex flex-wrap gap-2 pt-2">
                    {p.award && <span class="tag award">{p.award}</span>}
                    {p.venue && <span class="tag venue">{p.venue}</span>}
                    {p.links.map((link) => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="tag link-tag">
                            {link.display}
                        </a>
                    ))}
                </div>
            </div>
            {p.imgSrc && (
                <img
                    src={p.imgSrc}
                    alt=""
                    loading="lazy"
                    class="aspect-[16/10] h-full w-full border-t border-[var(--border)] bg-[var(--surface-muted)] object-contain p-4 lg:order-last lg:aspect-auto lg:border-t-0 lg:border-l"
                />
            )}
        </article>
    ))}
</div>

<style>
    .tag { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: 999px; padding: 0.28rem 0.65rem; font-size: 0.7rem; font-weight: 650; line-height: 1.2; }
    .award { border-color: color-mix(in srgb, var(--goldenrod) 55%, var(--border)); background: color-mix(in srgb, var(--goldenrod) 13%, var(--surface)); color: var(--text); }
    .venue { background: var(--surface-muted); color: var(--text); }
    .link-tag { color: var(--link); text-decoration: none; }
    .link-tag:hover { border-color: var(--link); background: var(--surface-muted); }
</style>
