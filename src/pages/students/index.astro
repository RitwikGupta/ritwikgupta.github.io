---
import Layout from "../../layouts/Layout.astro";
import StudentList from "./_list.md";
---

<Layout
    title="Ritwik Gupta | Students"
    desc="AI and Policy researcher driving innovation in humanitarian assistance and disaster response (HADR)"
>
    <main
        class="w-full md:w-3/4 xl:w-7/12 flex items-center justify-center flex-col gap-y-10 p-12"
    >
        <div class="flex items-start justify-start w-full">
            <a
                href="/"
                class="text-sm text-left text-gray-400 hover:text-gray-500 transition-colors font-semibold"
                >&larr; Back to home</a
            >
        </div>
        <h1 class="text-2xl sm:text-4xl font-bold">Students</h1>
        <div
            class="prose prose-a:text-blue-500 hover:prose-a:text-blue-600 transition-colors"
        >
            <StudentList />
        </div>
    </main>
</Layout>
