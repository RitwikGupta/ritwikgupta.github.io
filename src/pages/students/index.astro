---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { studentSections, students } from "./_data";
---

<Layout
    title="Ritwik Gupta | Students"
>
    <main class="site-shell">
        <PageHeader title="Students" />
        <div class="w-full space-y-14">
            {
                studentSections.map((section) => {
                    const sectionStudents = students.filter(
                        (student) => student.section === section.id
                    );

                    if (sectionStudents.length === 0) return null;

                    return (
                        <section aria-labelledby={`${section.id}-heading`} class="space-y-6">
                            <div class="border-b border-[var(--border)] pb-3">
                                <h2
                                    id={`${section.id}-heading`}
                                    class="text-2xl font-bold"
                                >
                                    {section.title}
                                </h2>
                            </div>
                            <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                                {sectionStudents.map((student) => (
                                    <article class="surface-card flex h-full flex-col items-start gap-5 p-5 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] sm:flex-row sm:items-center">
                                        <img
                                            src={student.image}
                                            alt={`${student.name} portrait`}
                                            width="600"
                                            height="600"
                                            loading="lazy"
                                            decoding="async"
                                            class="h-28 w-28 shrink-0 rounded-xl border border-[var(--border)] object-cover sm:h-32 sm:w-32"
                                        />
                                        <div class="min-w-0 space-y-2">
                                            <div>
                                                <a
                                                    href={student.website}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-lg font-bold"
                                                >
                                                    {student.name}
                                                </a>
                                                <p class="sans mt-1 text-sm font-semibold text-[var(--text)]">
                                                    {student.role}
                                                </p>
                                                <p class="sans text-sm leading-snug text-[var(--text-muted)]">
                                                    {student.institution}
                                                </p>
                                            </div>
                                            {student.email && (
                                                <a
                                                    href={`mailto:${student.email}`}
                                                    class="sans inline-flex text-sm font-semibold"
                                                >
                                                    {student.email}
                                                </a>
                                            )}
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </section>
                    );
                })
            }
        </div>
    </main>
</Layout>
