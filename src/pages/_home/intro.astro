---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import profile from "../../../public/profile.jpg";
import twitter from "../../../public/icons/twitter.svg";
import bluesky from "../../../public/icons/bluesky.svg";
import linkedin from "../../../public/icons/linkedin.svg";
import github from "../../../public/icons/github.svg";

interface BaseLink {
    url: string;
    text: string;
}

interface IconLink extends BaseLink {
    displayType: "image";
    imageSrc: ImageMetadata;
}

interface TextLink extends BaseLink {
    displayType: "text";
}

type Link = IconLink | TextLink;

const links: Link[] = [
    {
        url: "https://twitter.com/Ritwik_G",
        displayType: "image",
        text: "twitter",
        imageSrc: twitter,
    },
    {
        url: "https://bsky.app/profile/ritwikgupta.bsky.social",
        displayType: "image",
        text: "bluesky",
        imageSrc: bluesky,
    },
    {
        url: "https://www.linkedin.com/in/ritwikgupta",
        displayType: "image",
        text: "linkedin",
        imageSrc: linkedin,
    },
    {
        url: "https://github.com/RitwikGupta",
        displayType: "image",
        text: "github",
        imageSrc: github,
    },
    {
        url: "https://scholar.google.com/citations?user=4Cdwp_MAAAAJ&hl=en",
        displayType: "text",
        text: "Google Scholar",
    },
    {
        url: "https://orcid.org/0000-0001-7608-3832",
        displayType: "text",
        text: "ORCID",
    },
];
---

<section
    class="w-full max-w-[70ch] flex items-center justify-center flex-col lg:flex-row gap-x-14 gap-y-6"
>
    <Image
        src={profile}
        alt="Ritwik Gupta profile picture"
        width={150}
        height={150}
        quality={85}
        format="webp"
        loading="eager"
        class="h-40 w-40 rounded-2xl border border-[var(--border)] object-cover shadow-sm"
    />
    <div
        class="flex items-center lg:items-start justify-center flex-col gap-y-2 lg:gap-y-4"
    >
        <div class="flex flex-col items-center justify-center gap-y-1 lg:items-start">
            <h1 class="text-3xl font-bold sm:text-5xl">Ritwik Gupta</h1>
            <p class="sans text-sm text-[var(--text-muted)]">ritwikg [at] umd.edu</p>
        </div>
        <h2 class="max-w-xl text-center font-serif text-base font-normal leading-relaxed tracking-normal text-[var(--text-muted)] sm:text-lg lg:text-left">
            AI in chaotic environments and governance of dual-use military-civil AI
        </h2>
        <div class="flex items-stretch justify-center flex-row gap-2 flex-wrap">
            {
                links.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="sans flex items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-xs font-semibold text-[var(--text)] no-underline transition hover:border-[var(--border-strong)] hover:text-[var(--link)]"
                    >
                        {link.displayType === "image" ? (
                            <Image
                                src={link.imageSrc}
                                alt={link.text}
                                width={20}
                                class="dark:invert"
                            />
                        ) : (
                            link.text
                        )}
                    </a>
                ))
            }
        </div>
    </div>
</section>
